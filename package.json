{
  "name": "dsh-live-thinking",
  "version": "0.1.0",
  "description": "DeepSeek Harness 客户端插件：在输入框下方增加一行实时的「思考中 / 正在调用工具 / 输出中」状态，带实时计时，替代滞后的静态提示。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "thinking",
    "status",
    "activity"
  ],
  "license": "MIT",
  "author": "kongxiangrui,ciallo(∠・ω)⌒☆",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/live-thinking.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "overlay.ps1",
    "start-overlay.vbs",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  }
}
